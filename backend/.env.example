# ==============================================================================
# WCE Campus Assistant Backend Configuration
# ==============================================================================

# Server Listening Port (Default: 5000)
PORT=5000

# Groq API Credentials
# Obtain an API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Identifier
# Recommended: llama-3.3-70b-versatile (high accuracy) or llama-3.1-8b-instant (ultra-fast)
GROQ_MODEL=llama-3.3-70b-versatile

# Allowed Frontend Client URL (for CORS)
FRONTEND_URL=http://localhost:5173
